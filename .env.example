# docker compose 用の環境変数です。
# このファイルを .env にコピーして値を設定してください:  cp .env.example .env
# .env は .gitignore で除外されています。コミットしないでください。

# MySQL の root パスワード（必須）
# laravel_app/.env の DB_PASSWORD と同じ値にしてください。
# 注意: MySQL がこの値を使うのは laravel_app/mysql_data が空の状態で初めて起動したときだけです。
#       あとから変える場合は、DB 内でパスワードを変更するか、mysql_data を作り直してください。
DB_ROOT_PASSWORD=

# 作成するデータベース名（省略時は dev）
# laravel_app/.env の DB_DATABASE と同じ値にしてください。
DB_DATABASE=dev
